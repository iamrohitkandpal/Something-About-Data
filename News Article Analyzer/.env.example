# News API Configuration
NEWS_API_KEY=your_api_key_here

# Get your free API key from: https://newsapi.org/
# Free tier: 1000 requests/day
# Documentation: https://newsapi.org/docs

# Optional: Default search parameters
DEFAULT_LANGUAGE=en
DEFAULT_PAGE_SIZE=100

# Keyword matching threshold (0.7=loose, 0.9=strict, 1.0=exact)
# 0.7: Requires 70% of keywords to match (loose matching, more results)
# 0.9: Requires 90% of keywords to match (strict matching, fewer results)
# 1.0: Requires 100% of keywords to match (exact matching, most relevant)
MATCH_THRESHOLD=0.9